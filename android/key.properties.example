# 업로드 키 설정. 이 파일을 key.properties로 복사해서 값을 채운다.
# key.properties와 *.jks는 .gitignore에 걸려 있다 — 절대 커밋하지 말 것.
#
# 키스토어 만들기(비밀번호는 직접 정하고, 잃어버리면 앱을 영영 업데이트 못 한다):
#
#   keytool -genkey -v -keystore ~/capydoku-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile은 android/ 폴더 기준 상대경로 또는 절대경로.
storeFile=/Users/내계정/capydoku-upload.jks
storePassword=
keyAlias=upload
keyPassword=
